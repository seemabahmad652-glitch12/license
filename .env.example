# Copy this file's shape into Railway's Variables tab for this service -
# don't commit a real .env with real values (see .gitignore).

# Set automatically by Railway once you attach the Postgres plugin to
# this service - you usually don't type this one in by hand, just
# reference it ("Add variable reference" -> Postgres -> DATABASE_URL).
DATABASE_URL=postgresql://user:password@host:5432/railway

# Generate both of these yourself - any long random string works, e.g.
# `openssl rand -hex 32` run locally. Keep them secret.

# Must match the CLIENT_SHARED_SECRET constant in the AfkStrike desktop
# app's src-tauri/src/license.rs - this is what the app sends on every
# /verify call so random internet traffic can't probe this endpoint.
CLIENT_SHARED_SECRET=change-me-long-random-string

# Only used by you (curl/Postman/etc.) to call the /admin/* routes that
# create, list, revoke, and reset license keys. Never put this in the
# desktop app.
ADMIN_SECRET=change-me-a-different-long-random-string

# Railway sets PORT automatically - no need to set this yourself.
# PORT=3000
